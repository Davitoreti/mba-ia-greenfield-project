# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# AIStor Free (single node); download your free license separately.
MINIO_LICENSE_PATH=./.secrets/minio.license
MINIO_MEMORY_LIMIT=2g
STORAGE_ENDPOINT=http://minio:9000
# The client must resolve this hostname; never rewrite an already signed URL.
STORAGE_SIGNING_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=streamtube
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Redis/BullMQ (private Compose network)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
QUEUE_PREFIX=streamtube

# Worker budgets; initial concurrency is fixed at one.
VIDEO_WORKER_CPUS=2
VIDEO_WORKER_MEMORY_LIMIT=2g
VIDEO_WORKER_CONCURRENCY=1
VIDEO_FFMPEG_THREADS=2
VIDEO_PROCESSING_TIMEOUT_MS=3600000
VIDEO_TEMP_DIRECTORY=/var/tmp/streamtube
VIDEO_TEMP_BUDGET_BYTES=25769803776
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>
